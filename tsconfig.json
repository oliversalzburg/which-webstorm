{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"checkJs": true,
		"declaration": true,
		"incremental": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "output",
		"rootDir": "./source",
		"skipLibCheck": true,
		"sourceMap": true,
		"target": "esnext",
		"types": ["node"]
	},
	"include": ["./source"]
}
